# Environment variables

# Neon Postgres connection string
DATABASE_URL=

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Initial admin seed (used only by pnpm db:seed)
ADMIN_EMAIL=zazadzneladze@gmail.com
ADMIN_INITIAL_PASSWORD=

# Vercel Blob read/write token (server only — never expose to the browser)
BLOB_READ_WRITE_TOKEN=

# Public site URL (no trailing slash), e.g. https://dekabyte.ge
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Meta Pixel ID (loaded only after consent)
NEXT_PUBLIC_META_PIXEL_ID=

# Optional Resend (lead email alerts). Without these, leads still save to admin.
RESEND_API_KEY=
# e.g. DekaByte <onboarding@resend.dev> until a custom domain is verified
RESEND_FROM_EMAIL=
# Defaults to ADMIN / site email if empty
LEAD_NOTIFY_EMAIL=zazadzneladze@gmail.com
