# Environment variables

# Neon Postgres connection string
DATABASE_URL=

# Auth.js secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Public site URL (no trailing slash). Used by Auth.js / OG.
# Production example: https://dekabyte-zeta.vercel.app
AUTH_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (client portal). Create Web client in Google Cloud Console.
# Authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Initial admin seed (used only by pnpm db:seed)
ADMIN_EMAIL=zazadzneladze@gmail.com
ADMIN_INITIAL_PASSWORD=

# Vercel Blob read/write token (server only — never expose to the browser)
BLOB_READ_WRITE_TOKEN=

# Admin Web Push (VAPID). Generate with:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL, e.g. mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:zazadzneladze@gmail.com

# Optional Meta Pixel ID (loaded only after consent)
NEXT_PUBLIC_META_PIXEL_ID=

# Optional Resend (lead email alerts). Without these, leads still save to admin.
RESEND_API_KEY=
# e.g. DekaByte <onboarding@resend.dev> until a custom domain is verified
RESEND_FROM_EMAIL=
# Defaults to ADMIN / site email if empty
LEAD_NOTIFY_EMAIL=zazadzneladze@gmail.com
